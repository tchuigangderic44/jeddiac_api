# ==========================================
# JEDDIAC API - PRODUCTION ENVIRONMENT CONFIGURATION
# Domain: jeddiac.org (API: api.jeddiac.org)
# ==========================================

NODE_ENV=production
PORT=3000
API_PORT=3000
HOST=0.0.0.0

# CORS Allowed Origins
ALLOWED_ORIGINS=https://jeddiac.org,https://www.jeddiac.org,https://api.jeddiac.org

# ==========================================
# DATABASE CONFIGURATION
# Set DB_DIALECT=sqlite for persistent single-file DB or DB_DIALECT=mariadb for managed MySQL/MariaDB
# ==========================================
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# If DB_DIALECT=mariadb:
DB_HOST=127.0.0.1
db_port=3306
DB_USER=jeddiac_user
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD
production_db=jeddiac_prod

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION
TOKEN_EXP=24h

# ==========================================
# INITIAL SUPER ADMIN CREDENTIALS (Seeded once on initial run)
# ==========================================
admin_name=Super Admin
admin_email=contact@jeddiac.org
admin_password=YOUR_ADMIN_PASSWORD
admin_phone=+237697259231

# ==========================================
# SMTP MAILER CONFIGURATION (Nodemailer)
# ==========================================
mailer_account=notifications@jeddiac.org
mailer_host=smtp.mailgun.org
mailer_password=YOUR_SMTP_PASSWORD
